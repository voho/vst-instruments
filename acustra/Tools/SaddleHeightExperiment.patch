+float AcustraEngine::saddleHeightRatio() const noexcept
+{
+    // Scratch only: measured lower-string-boundary height / assumed impact
+    // half-spacing. No horizontal translation or rotation-axis height data.
+    if (parameters_.bridgeModel == BridgeModel::FyldeSteel
+        && parameters_.stringMaterial == StringMaterial::Steel)
+        return 0.0f;
+    return (parameters_.stringMaterial == StringMaterial::Steel
+        ? 0.0081f : 0.0102f) / 0.0232f;
+}
